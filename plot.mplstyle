# Stata-inspired Matplotlib style
# Apply with: plt.style.use("stata.mplstyle")

# Figure and plot backgrounds
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white

# Typography
font.family: sans-serif
font.sans-serif: Arial, Liberation Sans, DejaVu Sans
font.size: 10
axes.titlesize: 12
axes.labelsize: 10
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9

# Axes
axes.edgecolor: #555555
axes.linewidth: 0.8
axes.labelcolor: #222222
axes.spines.top: False
axes.spines.right: False

# Grid
axes.grid: True
axes.axisbelow: True
grid.color: #D9D9D9
grid.linestyle: -
grid.linewidth: 0.6

# Ticks
xtick.color: #333333
ytick.color: #333333
xtick.direction: out
ytick.direction: out
xtick.major.size: 3
ytick.major.size: 3
xtick.major.width: 0.7
ytick.major.width: 0.7

# Lines and markers
lines.linewidth: 1.8
lines.markersize: 5
axes.prop_cycle: cycler('color', ['#1F77B4', '#E15759', '#59A14F', '#8064A2', '#F28E2B', '#76B7B2'])

# Legend
legend.frameon: False

# Output quality
figure.dpi: 120
savefig.dpi: 300
